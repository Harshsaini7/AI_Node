# ============================================
# AI Loan Customer Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to Git!

# Which LLM to use: "groq" (hosted gpt-oss-120b), "gemini" (cloud) or "ollama" (local, no quota)
LLM_PROVIDER=groq

# Groq (only used when LLM_PROVIDER=groq)
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional, default is openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Gemini API Key (needed from Phase 3 onwards)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (optional). Pick one with a high free daily quota,
# see https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-2.5-flash-lite

# Ollama (only used when LLM_PROVIDER=ollama)
# 1. Install from https://ollama.com   2. Run: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434
