# ============================================
# AI Loan Customer Agent - .gitignore
# ============================================

# Environment variables (NEVER commit API keys!)
.env

# Python virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Generated spreadsheet data (optional - you may want to track this)
# loan_leads.xlsx

# Logs
*.log
